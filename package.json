{
  "name": "xpert-cold-start",
  "version": "0.1.0",
  "description": "Cold Start challenge solution: read a person's WhatsApp and produce output.json",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=cjs --outfile=dist/main.cjs",
    "typecheck": "tsc --noEmit",
    "eval": "tsx evals/main.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.2",
    "@t3-oss/env-core": "^0.13.11",
    "ai": "^6.0.5",
    "dotenv": "^18.0.9",
    "evalite": "^0.19.0",
    "zod": "^4.0.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
