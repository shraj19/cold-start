# OpenRouter endpoint (OpenAI-compatible)
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model to use (batch size auto-adjusts based on model context)
# Options: anthropic/claude-3.5-sonnet, openai/gpt-4o, google/gemini-flash-1.5
LLM_MODEL=anthropic/claude-3.5-sonnet

# Graders: provide your OpenRouter API key
LLM_API_KEY=
